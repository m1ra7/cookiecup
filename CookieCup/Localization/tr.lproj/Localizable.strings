"product.mezzoMix" = "Mezzo Mix Kutu";
"description.mezzoMix" = "Kola ve portakalın ferahlatıcı buluşması. Soğuk servis edilen 330 ml kutu.";
"portion.mezzoMix" = "1 kutu · 330 ml";
"ingredients.mezzoMix" = "Su, şeker, fruktoz, konsantreden portakal suyu (%1,5), karbondioksit, renklendirici E150d, sitrik asit, malik asit, aroma, kafein aroması ve stabilizör E412.";
"recipe.mezzoMix" = "1. Kutuyu buzdolabında soğutun.\n2. Açıp doğrudan veya buzlu bardakta servis edin.\nHazır içecektir; üreticinin üretim reçetesi kamuya açık değildir.";
"drinkNote.mezzoMix" = "Almanya ürün bilgisi: 32 kcal/100 ml × 3,3 ≈ 106 kcal/kutu. Kafein içerir. Formül değişebilir; kutu etiketini kontrol edin.";
"product.redBull" = "Red Bull Kutu";
"description.redBull" = "Klasik Red Bull Energy Drink. Soğuk servis edilen 250 ml kutu.";
"portion.redBull" = "1 kutu · 250 ml";
"ingredients.redBull" = "Su, sakkaroz, glikoz, sitrik asit, karbondioksit, taurin (%0,4), sodyum ve magnezyum karbonatlar, kafein (%0,03), niasin, pantotenik asit, B6 ve B12 vitaminleri, aromalar, karamel ve riboflavin renklendiricileri.";
"recipe.redBull" = "1. Kutuyu buzdolabında soğutun.\n2. Açıp soğuk servis edin.\nHazır içecektir; üreticinin üretim reçetesi kamuya açık değildir.";
"drinkNote.redBull" = "46 kcal/100 ml × 2,5 = 115 kcal/kutu. 250 ml’de 80 mg kafein içerir. Yüksek kafein içeriği: çocuklar, hamile ve emziren kişiler için önerilmez. Güncel kutu etiketi esas alınır.";
"product.mojito" = "Mojito";
"description.mojito" = "Beyaz rom, taze nane ve lime ile ferahlatıcı klasik kokteyl. Alkol içerir.";
"portion.mojito" = "1 kokteyl · buz hariç yaklaşık 165 ml";
"ingredients.mojito" = "45 ml beyaz rom (%40), 20 ml taze lime suyu, 6 küçük nane dalı, 2 çay kaşığı beyaz şeker (yaklaşık 8 g), yaklaşık 100 ml soda ve buz.";
"recipe.mojito" = "1. Nane, şeker ve lime suyunu bardakta hafifçe ezin.\n2. Biraz soda ve buz ekleyin.\n3. Romu dökün, kalan sodayı ekleyip yavaşça karıştırın.\n4. Nane ve lime ile süsleyin.";
"product.margarita" = "Margarita";
"description.margarita" = "Tekila, portakal likörü ve taze lime. Dengeli, narenciyeli klasik. Alkol içerir.";
"portion.margarita" = "1 kokteyl · sulandırma öncesi 85 ml";
"ingredients.margarita" = "50 ml %100 agave tekila (%40), 20 ml triple sec portakal likörü (%40), 15 ml taze lime suyu ve çalkalamak için buz. İsteğe bağlı yarım tuz kenarı.";
"recipe.margarita" = "1. Bardağı soğutun; isterseniz kenarının yarısını tuzlayın.\n2. Tekila, likör ve lime suyunu buzla çalkalayın.\n3. Soğuk bardağa süzerek servis edin.";
"product.pinaColada" = "Piña Colada";
"description.pinaColada" = "Ananas ve hindistan cevizi kremasını beyaz romla buluşturan tropik kokteyl. Alkol içerir.";
"portion.pinaColada" = "1 kokteyl · buz öncesi 130 ml";
"ingredients.pinaColada" = "50 ml beyaz rom (%40), 30 ml tatlandırılmış hindistan cevizi kreması, 50 ml ananas suyu ve buz. Süslemek için küçük ananas dilimi ve kokteyl kirazı.";
"recipe.pinaColada" = "1. Rom, hindistan cevizi kreması, ananas suyu ve buzu blendera koyun.\n2. Pürüzsüz, buzlu bir kıvam alana kadar karıştırın.\n3. Büyük bardağa dökün; ananas ve kirazla süsleyin.";
"product.sexOnTheBeach" = "Sex on the Beach";
"description.sexOnTheBeach" = "Votka, şeftali likörü, portakal ve cranberry ile meyvemsi kokteyl. Alkol içerir.";
"portion.sexOnTheBeach" = "1 kokteyl · buz hariç 140 ml";
"ingredients.sexOnTheBeach" = "40 ml votka (%40), 20 ml şeftali likörü, 40 ml taze portakal suyu, 40 ml cranberry suyu ve buz. Süslemek için yarım portakal dilimi.";
"recipe.sexOnTheBeach" = "1. Uzun bardağı buzla doldurun.\n2. Votka, şeftali likörü ve meyve sularını ekleyin.\n3. Hafifçe karıştırıp portakal dilimiyle servis edin.";

