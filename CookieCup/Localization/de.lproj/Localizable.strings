"portion.cubaLibre" = "1 Cocktail · 180 ml ohne Eis";
"ingredients.cubaLibre" = "50 ml weißer Rum (40 % vol), 120 ml zuckerhaltige Cola, 10 ml frischer Limettensaft und Eis. Limettenspalte als Garnitur.";
"recipe.cubaLibre" = "1. Ein hohes Glas mit Eis füllen.\n2. Rum, Limettensaft und Cola zugeben und vorsichtig rühren.\n3. Mit Limettenspalte servieren.";

