"portion.tequilaSunrise" = "1 Cocktail · 150 ml ohne Eis";
"ingredients.tequilaSunrise" = "45 ml Tequila (40 % vol), 90 ml frischer Orangensaft, 15 ml Grenadinesirup und Eis. Eine halbe Orangenscheibe und optional eine Cocktailkirsche als Garnitur.";
"recipe.tequilaSunrise" = "1. Ein hohes Glas mit Eis füllen, Tequila und Orangensaft zugeben.\n2. Grenadine langsam eingießen; für den Farbverlauf nicht umrühren.\n3. Mit Orange garnieren.";
"product.cubaLibre" = "Cuba Libre";
