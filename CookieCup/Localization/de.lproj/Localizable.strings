"portion.brownieDessert" = "1 Standardportion · Mengen siehe unten";
"ingredients.brownieDessert" = "15 g Weizenmehl\n25 g Zartbitterschokolade\n20 g Butter\n25 g Zucker\n20 g verquirltes Ei\n5 g Kakao";
"recipe.brownieDessert" = "Mengen vervierfachen. Schokolade und Butter schmelzen, etwas abkühlen. Ei und Zucker, dann Mehl und Kakao einrühren. In kleiner Form bei 175 °C ca. 20–25 Minuten backen. Abkühlen und vierteln.";
"allergens.brownieDessert" = "Weizen / Gluten, Milch, Ei, Soja (je nach Schokoladenetikett). Gilt für dieses Beispielrezept. Zutatenetiketten und mögliche Kreuzkontakte im Café prüfen.";
"portion.tiramisu" = "1 Standardportion · Mengen siehe unten";
"ingredients.tiramisu" = "45 g Mascarpone\n25 g Sahne\n12 g Zucker\n25 g Löffelbiskuits\n30 ml gebrühter Kaffee\n3 g Kakao";
"recipe.tiramisu" = "Sahne mit Zucker schlagen und unter Mascarpone heben. Löffelbiskuits kurz in kalten Kaffee tauchen. Mit Creme schichten, mit Kakao bestäuben und mindestens 4 Stunden kühlen. Ohne Alkohol oder rohes Ei.";
"allergens.tiramisu" = "Weizen / Gluten, Milch, Ei. Gilt für dieses Beispielrezept. Zutatenetiketten und mögliche Kreuzkontakte im Café prüfen.";
"portion.chocolateMuffin" = "1 Standardportion · Mengen siehe unten";
"ingredients.chocolateMuffin" = "35 g Weizenmehl\n22 g Zucker\n15 g Pflanzenöl\n20 g verquirltes Ei\n20 ml Vollmilch\n15 g Zartbitterschokolade\n5 g Kakao\n1 g Backpulver";
"recipe.chocolateMuffin" = "Für 4 Muffins Mengen vervierfachen. Trockene Zutaten getrennt von Ei, Milch und Öl mischen. Zusammengeben und Schokolade unterheben. Auf vier Formen verteilen; bei 180 °C ca. 20–25 Minuten backen.";
"allergens.chocolateMuffin" = "Weizen / Gluten, Milch, Ei, Soja (je nach Schokoladenetikett). Gilt für dieses Beispielrezept. Zutatenetiketten und mögliche Kreuzkontakte im Café prüfen.";
"portion.carrotCake" = "1 Standardportion · Mengen siehe unten";
"ingredients.carrotCake" = "25 g Weizenmehl\n40 g geriebene Karotte\n20 g Zucker\n12 g Pflanzenöl\n20 g verquirltes Ei\n10 g Walnüsse\n20 g Frischkäse\n0.5 g Zimt\n1 g Backpulver";
"recipe.carrotCake" = "Mengen vervierfachen. Ei, Zucker und Öl mischen, dann Mehl, Backpulver, Zimt, Karotte und Walnüsse unterheben. In kleiner Form bei 175 °C ca. 30–35 Minuten backen. Abkühlen, mit Frischkäse bestreichen und vierteln.";
"allergens.carrotCake" = "Weizen / Gluten, Milch, Ei, Walnüsse. Gilt für dieses Beispielrezept. Zutatenetiketten und mögliche Kreuzkontakte im Café prüfen.";
"portion.appleTart" = "1 Standardportion · Mengen siehe unten";
"ingredients.appleTart" = "30 g Weizenmehl\n18 g Butter\n15 g Zucker\n10 g verquirltes Ei\n70 g Apfel\n0.5 g Zimt";
"recipe.appleTart" = "Mengen vervierfachen. Aus Mehl, Butter und Ei einen Teig herstellen und 30 Minuten kühlen. Kleine Tarteform auslegen. Äpfel mit Zucker und Zimt mischen und daraufgeben. Bei 180 °C ca. 30–35 Minuten backen; vierteln.";
