"product.mezzoMix" = "Mezzo Mix Can";
"description.mezzoMix" = "Cola meets orange in a refreshing 330 ml can, served chilled.";
"portion.mezzoMix" = "1 can · 330 ml";
"ingredients.mezzoMix" = "Water, sugar, fructose, orange juice from concentrate (1.5%), carbon dioxide, colour E150d, citric acid, malic acid, flavouring, caffeine flavouring and stabiliser E412.";
"recipe.mezzoMix" = "1. Refrigerate the can.\n2. Open and serve directly or pour over ice.\nReady-made drink; the manufacturer’s production formula is not public.";
"drinkNote.mezzoMix" = "German product information: 32 kcal/100 ml × 3.3 ≈ 106 kcal/can. Contains caffeine. Formulations may change; check the can label.";
"product.redBull" = "Red Bull Can";
"description.redBull" = "Original Red Bull Energy Drink in a chilled 250 ml can.";
"portion.redBull" = "1 can · 250 ml";
"ingredients.redBull" = "Water, sucrose, glucose, citric acid, carbon dioxide, taurine (0.4%), sodium and magnesium carbonates, caffeine (0.03%), niacin, pantothenic acid, vitamins B6 and B12, flavourings, caramel and riboflavin colours.";
"recipe.redBull" = "1. Refrigerate the can.\n2. Open and serve chilled.\nReady-made drink; the manufacturer’s production formula is not public.";
"drinkNote.redBull" = "46 kcal/100 ml × 2.5 = 115 kcal/can. Contains 80 mg caffeine per 250 ml. High caffeine content: not recommended for children or pregnant or breastfeeding people. Refer to the current can label.";
"product.mojito" = "Mojito";
"description.mojito" = "A refreshing classic with white rum, fresh mint and lime. Contains alcohol.";
"portion.mojito" = "1 cocktail · about 165 ml before ice";
"ingredients.mojito" = "45 ml white rum (40% ABV), 20 ml fresh lime juice, 6 small mint sprigs, 2 tsp white sugar (about 8 g), about 100 ml soda water and ice.";
"recipe.mojito" = "1. Gently press mint with sugar and lime juice in the glass.\n2. Add a little soda and ice.\n3. Pour in rum, add the remaining soda and stir gently.\n4. Finish with mint and lime.";
"product.margarita" = "Margarita";
"description.margarita" = "Tequila, orange liqueur and fresh lime in a balanced citrus classic. Contains alcohol.";
"portion.margarita" = "1 cocktail · 85 ml before dilution";
"ingredients.margarita" = "50 ml 100% agave tequila (40% ABV), 20 ml triple sec orange liqueur (40% ABV), 15 ml fresh lime juice and ice for shaking. Optional half salt rim.";
"recipe.margarita" = "1. Chill the glass and optionally salt half the rim.\n2. Shake tequila, liqueur and lime juice with ice.\n3. Strain into the chilled glass and serve.";
"product.pinaColada" = "Piña Colada";
"description.pinaColada" = "A creamy tropical blend of pineapple, coconut cream and white rum. Contains alcohol.";
"portion.pinaColada" = "1 cocktail · 130 ml before ice";
"ingredients.pinaColada" = "50 ml white rum (40% ABV), 30 ml sweetened cream of coconut, 50 ml pineapple juice and ice. Small pineapple wedge and cocktail cherry to garnish.";
"recipe.pinaColada" = "1. Add rum, coconut cream, pineapple juice and ice to a blender.\n2. Blend until smooth and frosty.\n3. Pour into a large glass; garnish with pineapple and cherry.";
"product.sexOnTheBeach" = "Sex on the Beach";
"description.sexOnTheBeach" = "A fruity blend of vodka, peach schnapps, orange and cranberry. Contains alcohol.";
"portion.sexOnTheBeach" = "1 cocktail · 140 ml before ice";
"ingredients.sexOnTheBeach" = "40 ml vodka (40% ABV), 20 ml peach schnapps, 40 ml fresh orange juice, 40 ml cranberry juice and ice. Half an orange slice to garnish.";
"recipe.sexOnTheBeach" = "1. Fill a tall glass with ice.\n2. Add vodka, peach schnapps and both juices.\n3. Stir gently and finish with an orange slice.";

/* More cocktails and Turkish canned drinks */
"product.sariyerCola" = "Sarıyer Cola Can";
"description.sariyerCola" = "Classic Sarıyer cola in a chilled 330 ml can.";
"portion.sariyerCola" = "1 can · 330 ml";
"ingredients.sariyerCola" = "Water, sugar or corn fructose-glucose syrup, carbon dioxide, sulphite ammonia caramel, phosphoric acid, flavourings, gum arabic, sodium benzoate and caffeine. The can base identifies the sweetener used.";
"recipe.sariyerCola" = "1. Chill the can in the refrigerator.\n2. Open and serve directly or over ice.\nReady-made drink; the production formula is not public.";
"drinkNote.sariyerCola" = "Turkish product information: 42 kcal/100 ml × 3.3 ≈ 139 kcal/can. Contains caffeine. Formulas may vary by market and batch; check the current can label.";
"product.sariyerOrange" = "Sarıyer Orange Can";
"description.sariyerOrange" = "Refreshing sparkling orange drink in a chilled 330 ml can.";
"portion.sariyerOrange" = "1 can · 330 ml";
"ingredients.sariyerOrange" = "Water, sugar or fructose-glucose syrup, carbon dioxide, orange and lemon juice concentrates, citric acid, gum arabic, glycerol esters of wood rosin, potassium sorbate, sodium benzoate, ascorbic acid, flavourings and carotenes.";
"recipe.sariyerOrange" = "1. Chill the can in the refrigerator.\n2. Open and serve directly or over ice.\nReady-made drink; the production formula is not public.";
"drinkNote.sariyerOrange" = "Turkish product information: 45 kcal/100 ml × 3.3 ≈ 149 kcal/can. Formulas may vary by market and batch; check the current can label.";
"product.didiPeach" = "Didi Peach Iced Tea Can";
"description.didiPeach" = "Refreshing Didi black tea with peach flavour in a 330 ml can.";
"portion.didiPeach" = "1 can · 330 ml";
"ingredients.didiPeach" = "Water, sugar, citric acid, trisodium citrate, black tea extract and peach flavouring. Pasteurised; contains caffeine from tea.";
"recipe.didiPeach" = "1. Chill the can, then open and serve cold.\n2. Refrigerate after opening and consume within 2 days.\nReady-made drink; the production formula is not public.";
"drinkNote.didiPeach" = "Turkish label information: 32 kcal/100 ml × 3.3 ≈ 106 kcal/can. Tea-derived caffeine: up to 80 mg/l. Formulas may vary by market and batch; check the current label.";
"product.cosmopolitan" = "Cosmopolitan";
"description.cosmopolitan" = "An elegant citrus cocktail with citron vodka, orange liqueur and cranberry. Contains alcohol.";
"portion.cosmopolitan" = "1 cocktail · 100 ml before dilution";
"ingredients.cosmopolitan" = "40 ml citron vodka (40% ABV), 15 ml Cointreau (40% ABV), 15 ml fresh lime juice, 30 ml cranberry juice. Ice for shaking; lemon peel to garnish.";
"recipe.cosmopolitan" = "1. Combine the liquids in an ice-filled shaker.\n2. Shake thoroughly and strain into a chilled cocktail glass.\n3. Finish with lemon peel.";
"product.daiquiri" = "Daiquiri";
"description.daiquiri" = "A balanced classic of white rum, fresh lime and sugar. Contains alcohol.";
"portion.daiquiri" = "1 cocktail · 80 ml liquid + sugar, before dilution";
"ingredients.daiquiri" = "60 ml white rum (40% ABV), 20 ml fresh lime juice, 2 bar spoons fine sugar (8 g in this recipe) and ice for shaking.";
"recipe.daiquiri" = "1. Stir rum, lime juice and sugar in a shaker until the sugar dissolves.\n2. Add ice and shake.\n3. Strain into a chilled coupe and serve without ice in the glass.";
"product.tequilaSunrise" = "Tequila Sunrise";
"description.tequilaSunrise" = "Sunrise colours from tequila, orange juice and grenadine. Contains alcohol.";
"portion.tequilaSunrise" = "1 cocktail · 150 ml before ice";
"ingredients.tequilaSunrise" = "45 ml tequila (40% ABV), 90 ml fresh orange juice, 15 ml grenadine syrup and ice. Half an orange slice and optional cocktail cherry to garnish.";
"recipe.tequilaSunrise" = "1. Fill a tall glass with ice, then add tequila and orange juice.\n2. Slowly pour in grenadine; leave unstirred to keep the colour gradient.\n3. Garnish with orange.";
"product.cubaLibre" = "Cuba Libre";
"description.cubaLibre" = "A refreshing classic with white rum, cola and fresh lime. Contains alcohol.";
"portion.cubaLibre" = "1 cocktail · 180 ml before ice";
"ingredients.cubaLibre" = "50 ml white rum (40% ABV), 120 ml regular sugared cola, 10 ml fresh lime juice and ice. Lime wedge to garnish.";
"recipe.cubaLibre" = "1. Fill a tall glass with ice.\n2. Add rum, lime juice and cola, then stir gently.\n3. Serve with a lime wedge.";

