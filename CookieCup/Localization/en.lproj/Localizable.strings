"product.butterBrezel" = "Butter Pretzel";
"description.butterBrezel" = "A crisp salted pretzel generously filled with butter.";
"ingredients.butterBrezel" = "90 g baked wheat pretzel, 20 g butter.";
"recipe.butterBrezel" = "1 piece · approximately 110 g\n\nSlice the pretzel horizontally, spread butter inside and serve fresh.\n\nSuggested cafe recipe; calories vary with portion and ingredients. Confirm cross-contact information with the cafe.";
