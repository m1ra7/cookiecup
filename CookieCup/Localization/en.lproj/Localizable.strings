"drinkNote.simit" = "Suggested cafe recipe; calories vary with portion and ingredients. Confirm cross-contact information with the cafe.";
"product.pogaca" = "Plain Poğaça";
"description.pogaca" = "A soft Turkish bakery roll with a golden glazed crust.";
"ingredients.pogaca" = "40 g wheat flour, 15 ml milk, 10 g butter, 8 g egg, 3 g sugar, 1 g yeast, 0.5 g salt.";
"recipe.pogaca" = "1 piece · approximately 80 g\n\nKnead and prove for 45 minutes. Shape an oval roll, glaze with part of the egg and bake at 180 °C for about 20–25 minutes.\n\nSuggested cafe recipe; calories vary with portion and ingredients. Confirm cross-contact information with the cafe.";
"allergens.pogaca" = "Wheat / gluten, milk, egg.";
"portion.pogaca" = "1 piece · approximately 80 g";
"drinkNote.pogaca" = "Suggested cafe recipe; calories vary with portion and ingredients. Confirm cross-contact information with the cafe.";
"product.kasarliPogaca" = "Kaşar Cheese Poğaça";
"description.kasarliPogaca" = "Soft Turkish pastry filled with melting kaşar cheese.";
"ingredients.kasarliPogaca" = "35 g wheat flour, 12 ml milk, 8 g butter, 8 g egg, 20 g kaşar cheese, 2 g sugar, 1 g yeast, 1 g sesame, 0.5 g salt.";
"recipe.kasarliPogaca" = "1 piece · approximately 90 g\n\nPrepare and prove the dough for 45 minutes. Enclose the cheese, glaze with egg, sprinkle sesame and bake at 180 °C for 20–25 minutes.\n\nSuggested cafe recipe; calories vary with portion and ingredients. Confirm cross-contact information with the cafe.";
"allergens.kasarliPogaca" = "Wheat / gluten, milk, egg, sesame.";
"portion.kasarliPogaca" = "1 piece · approximately 90 g";
"drinkNote.kasarliPogaca" = "Suggested cafe recipe; calories vary with portion and ingredients. Confirm cross-contact information with the cafe.";
"product.zeytinliPogaca" = "Olive Poğaça";
"description.zeytinliPogaca" = "Soft Turkish pastry with black olive filling and nigella seeds.";
"ingredients.zeytinliPogaca" = "40 g wheat flour, 12 ml milk, 9 g butter, 8 g egg, 15 g pitted black olives, 2 g sugar, 1 g yeast, 1 g nigella seeds, 0.5 g salt.";
"recipe.zeytinliPogaca" = "1 piece · approximately 90 g\n\nPrepare the dough and prove for 45 minutes. Fill with chopped olives, glaze with egg, sprinkle nigella seeds and bake at 180 °C for 20–25 minutes.\n\nSuggested cafe recipe; calories vary with portion and ingredients. Confirm cross-contact information with the cafe.";
